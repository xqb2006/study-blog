---
const title = '博客管理后台';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main class="admin-shell">
      <aside class="sidebar">
        <div class="brand-mark"><span>SB</span><div><strong>Study Blog</strong><small>内容管理后台</small></div></div>
        <nav>
          <button class="nav-item active" data-tab="posts">文章管理</button>
          <button class="nav-item" data-tab="profile">个人信息</button>
        </nav>
        <div class="sidebar-note"><span class="status-dot"></span><span>GitHub 自动发布</span></div>
      </aside>

      <section class="workspace">
        <header class="topbar">
          <div><p class="eyebrow">CONTENT WORKSPACE</p><h1 id="page-title">文章管理</h1></div>
          <div class="account"><span id="account-name">未登录</span><button id="logout" class="secondary-button hidden">退出</button></div>
        </header>

        <div id="notice" class="notice hidden"></div>
        <section id="login-panel" class="login-panel hidden">
          <div class="login-icon">✦</div>
          <h2>登录博客后台</h2>
          <p>使用你的 GitHub 账号登录。只有授权账号可以修改博客内容。</p>
          <a class="primary-button" href="/api/admin/login">使用 GitHub 登录</a>
        </section>

        <section id="posts-tab" class="tab-panel">
          <div class="toolbar"><div><h2>文章</h2><p>在这里创建、编辑和删除博客文章。</p></div><button id="new-post" class="primary-button">＋ 新建文章</button></div>
          <div class="content-grid">
            <div class="panel post-list-panel"><div class="panel-heading"><span>文章列表</span><span id="post-count" class="muted">0 篇</span></div><div id="post-list" class="post-list"></div></div>
            <div class="panel editor-panel">
              <div class="panel-heading"><span id="editor-title">选择一篇文章</span><button id="delete-post" class="danger-button hidden">删除</button></div>
              <form id="post-form" class="editor-form">
                <label>标题<input id="post-title" required placeholder="文章标题" /></label>
                <div class="field-row"><label>分类<input id="post-category" placeholder="随笔" /></label><label>标签<input id="post-tags" placeholder="学习, 记录" /></label></div>
                <label>简介<input id="post-description" placeholder="文章简介" /></label>
                <div class="field-row"><label>发布日期<input id="post-date" type="datetime-local" required /></label><label>文件名<input id="post-path" placeholder="新建时可留空" /></label></div>
                <label>正文 <textarea id="post-content" rows="18" placeholder="使用 Markdown 写文章正文"></textarea></label>
                <div class="form-actions"><button type="submit" class="primary-button">保存并发布</button><span class="muted">保存后 Cloudflare 会自动部署</span></div>
              </form>
            </div>
          </div>
        </section>

        <section id="profile-tab" class="tab-panel hidden">
          <div class="toolbar"><div><h2>个人信息</h2><p>修改博客名称、作者、简介和站点地址。</p></div></div>
          <div class="panel settings-panel"><form id="settings-form" class="editor-form">
            <div class="field-row"><label>博客标题<input id="site-title" /></label><label>英文标题<input id="site-alternate" /></label></div>
            <label>副标题<input id="site-subtitle" /></label><label>作者姓名<input id="site-name" /></label>
            <label>个人简介<textarea id="site-description" rows="4"></textarea></label>
            <div class="field-row"><label>头像路径<input id="site-avatar" /></label><label>博客地址<input id="site-url" /></label></div>
            <div class="form-actions"><button type="submit" class="primary-button">保存个人信息</button><span class="muted">修改会写入 GitHub</span></div>
          </form></div>
        </section>
      </section>
    </main>
  </body>
</html>

<style>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #111827; background: #f8fafc; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  button, input, textarea { font: inherit; }
  button, a { cursor: pointer; }
  .admin-shell { min-height: 100vh; display: flex; }
  .sidebar { width: 248px; flex: 0 0 248px; background: #111827; color: #e5e7eb; padding: 24px 16px; display: flex; flex-direction: column; }
  .brand-mark { display: flex; align-items: center; gap: 12px; padding: 4px 10px 32px; }
  .brand-mark > span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: #6366f1; color: white; font-size: 13px; font-weight: 700; }
  .brand-mark strong, .brand-mark small { display: block; }
  .brand-mark strong { font-size: 14px; letter-spacing: .02em; }
  .brand-mark small { margin-top: 3px; color: #9ca3af; font-size: 11px; }
  nav { display: grid; gap: 6px; }
  .nav-item { width: 100%; border: 0; border-radius: 10px; padding: 12px 14px; color: #9ca3af; background: transparent; text-align: left; font-size: 14px; transition: background-color .2s, color .2s; }
  .nav-item:hover, .nav-item.active { color: white; background: #1f2937; }
  .nav-item.active { box-shadow: inset 3px 0 #818cf8; }
  .sidebar-note { margin-top: auto; padding: 14px 10px 4px; display: flex; gap: 8px; align-items: center; color: #9ca3af; font-size: 12px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; }
  .workspace { min-width: 0; flex: 1; padding: 28px clamp(18px, 4vw, 56px); }
  .topbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 1px solid #e5e7eb; padding-bottom: 22px; }
  .eyebrow { margin: 0 0 6px; color: #6366f1; font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  h1, h2, p { margin-top: 0; } h1 { margin-bottom: 0; font-size: 26px; letter-spacing: -.03em; } h2 { margin-bottom: 5px; font-size: 20px; letter-spacing: -.02em; } p { color: #6b7280; font-size: 13px; }
  .account { display: flex; align-items: center; gap: 12px; color: #4b5563; font-size: 13px; }
  .toolbar { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 26px 0 18px; }
  .content-grid { display: grid; grid-template-columns: minmax(230px, .75fr) minmax(0, 1.6fr); gap: 18px; align-items: start; }
  .panel { background: white; border: 1px solid #f3f4f6; border-radius: 12px; box-shadow: 0 1px 3px rgb(15 23 42 / 5%); }
  .panel-heading { min-height: 54px; display: flex; justify-content: space-between; align-items: center; padding: 0 18px; border-bottom: 1px solid #f3f4f6; font-size: 13px; font-weight: 600; }
  .post-list { padding: 8px; max-height: 660px; overflow: auto; }
  .post-item { width: 100%; border: 0; border-radius: 10px; background: transparent; padding: 13px 12px; text-align: left; transition: background-color .2s; }
  .post-item:hover, .post-item.selected { background: #eef2ff; }
  .post-item strong, .post-item small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .post-item strong { color: #1f2937; font-size: 13px; } .post-item small { margin-top: 5px; color: #9ca3af; font-size: 11px; }
  .editor-form { display: grid; gap: 15px; padding: 20px; }
  label { display: grid; gap: 7px; color: #374151; font-size: 12px; font-weight: 600; }
  input, textarea { width: 100%; border: 1px solid #e5e7eb; border-radius: 10px; background: #f9fafb; color: #111827; padding: 10px 12px; font-size: 13px; outline: none; transition: border-color .2s, box-shadow .2s, background-color .2s; }
  input:focus, textarea:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgb(99 102 241 / 14%); }
  textarea { resize: vertical; line-height: 1.65; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: 2px; }
  .primary-button, .secondary-button, .danger-button { display: inline-flex; justify-content: center; align-items: center; border: 0; border-radius: 10px; padding: 10px 15px; font-size: 13px; font-weight: 600; text-decoration: none; transition: background-color .2s, color .2s, transform .1s; }
  .primary-button { background: #6366f1; color: white; } .primary-button:hover { background: #4f46e5; } .primary-button:active, .secondary-button:active, .danger-button:active { transform: scale(.97); }
  .secondary-button { background: #f3f4f6; color: #4b5563; } .secondary-button:hover { background: #e5e7eb; }
  .danger-button { background: #fef2f2; color: #dc2626; } .danger-button:hover { background: #fee2e2; }
  .muted { color: #9ca3af; font-size: 12px; font-weight: 400; }
  .notice { margin-top: 18px; border-radius: 10px; padding: 11px 14px; background: #ecfdf5; color: #047857; font-size: 13px; } .notice.error { background: #fef2f2; color: #b91c1c; }
  .login-panel { max-width: 480px; margin: 15vh auto 0; padding: 42px 30px; border: 1px solid #f3f4f6; border-radius: 12px; background: white; box-shadow: 0 1px 3px rgb(15 23 42 / 5%); text-align: center; } .login-icon { margin: 0 auto 18px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: #eef2ff; color: #6366f1; font-size: 23px; }
  .login-panel h2 { font-size: 22px; } .login-panel p { line-height: 1.7; margin-bottom: 24px; }
  .hidden { display: none !important; }
  @media (max-width: 820px) { .sidebar { width: 72px; flex-basis: 72px; padding: 18px 10px; } .brand-mark { padding: 0 7px 28px; } .brand-mark > div, .nav-item { font-size: 0; } .nav-item { height: 44px; } .sidebar-note { display: none; } .content-grid { grid-template-columns: 1fr; } .post-list { max-height: 230px; } }
  @media (max-width: 560px) { .workspace { padding: 20px 14px; } .topbar, .toolbar { align-items: flex-start; flex-direction: column; } .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  // @ts-nocheck
  const $ = (selector) => document.querySelector(selector);
  const notice = (message, error = false) => { const el = $('#notice'); el.textContent = message; el.classList.remove('hidden', 'error'); if (error) el.classList.add('error'); window.setTimeout(() => el.classList.add('hidden'), 4500); };
  const api = async (url, options) => { const response = await fetch(url, options); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || '请求失败'); return data; };
  let posts = [];
  let activePost = null;

  const formatDate = (value) => value ? String(value).replace('T', ' ').slice(0, 16) : '';
  const toInputDate = (value) => { const text = String(value || '').replace(' ', 'T'); return text.length === 16 ? text : new Date().toISOString().slice(0, 16); };

  function renderPosts() {
    $('#post-count').textContent = `${posts.length} 篇`;
    $('#post-list').innerHTML = posts.length ? posts.map((post, index) => `<button class="post-item ${activePost?.path === post.path ? 'selected' : ''}" data-index="${index}"><strong>${post.frontmatter.title || post.path}</strong><small>${formatDate(post.frontmatter.date)} · ${post.path.split('/').pop()}</small></button>`).join('') : '<p class="muted" style="padding:14px">还没有文章，点击右上角新建。</p>';
    document.querySelectorAll('.post-item').forEach((item) => item.addEventListener('click', () => selectPost(posts[Number(item.dataset.index)])));
  }

  function selectPost(post) {
    activePost = post;
    $('#editor-title').textContent = post.frontmatter.title || '编辑文章';
    $('#post-title').value = post.frontmatter.title || '';
    $('#post-category').value = Array.isArray(post.frontmatter.categories) ? post.frontmatter.categories.join(', ') : '';
    $('#post-tags').value = Array.isArray(post.frontmatter.tags) ? post.frontmatter.tags.join(', ') : '';
    $('#post-description').value = post.frontmatter.description || '';
    $('#post-date').value = toInputDate(post.frontmatter.date);
    $('#post-path').value = post.path;
    $('#post-content').value = post.content || '';
    $('#delete-post').classList.remove('hidden');
    renderPosts();
  }

  function newPost() {
    activePost = null;
    $('#editor-title').textContent = '新建文章'; $('#post-form').reset(); $('#post-date').value = toInputDate(new Date().toISOString()); $('#post-path').value = ''; $('#delete-post').classList.add('hidden'); renderPosts();
  }

  async function loadPosts() { const data = await api('/api/admin/posts'); posts = data.posts; renderPosts(); if (posts[0]) selectPost(posts[0]); else newPost(); }
  async function loadSettings() { const data = await api('/api/admin/settings'); const site = data.site || {}; $('#site-title').value = site.title || ''; $('#site-alternate').value = site.alternate || ''; $('#site-subtitle').value = site.subtitle || ''; $('#site-name').value = site.name || ''; $('#site-description').value = site.description || ''; $('#site-avatar').value = site.avatar || ''; $('#site-url').value = site.url || ''; }

  function showTab(tab) { document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.add('hidden')); $(`#${tab}-tab`).classList.remove('hidden'); document.querySelectorAll('.nav-item').forEach((item) => item.classList.toggle('active', item.dataset.tab === tab)); $('#page-title').textContent = tab === 'posts' ? '文章管理' : '个人信息'; if (tab === 'profile') loadSettings().catch((error) => notice(error.message, true)); }

  async function init() {
    const session = await api('/api/admin/session');
    if (!session.authenticated) { $('#login-panel').classList.remove('hidden'); $('#posts-tab').classList.add('hidden'); return; }
    $('#account-name').textContent = session.user.login; $('#logout').classList.remove('hidden');
    await loadPosts();
  }

  $('#new-post').addEventListener('click', newPost);
  $('#delete-post').addEventListener('click', async () => { if (!activePost || !window.confirm('确定删除这篇文章吗？')) return; try { await api('/api/admin/posts', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: activePost.path, sha: activePost.sha }) }); notice('文章已删除，Cloudflare 将自动重新部署。'); await loadPosts(); } catch (error) { notice(error.message, true); } });
  $('#post-form').addEventListener('submit', async (event) => { event.preventDefault(); const date = $('#post-date').value.replace('T', ' ') + ':00'; const frontmatter = { title: $('#post-title').value.trim(), description: $('#post-description').value.trim(), date, categories: $('#post-category').value.split(',').map((item) => item.trim()).filter(Boolean), tags: $('#post-tags').value.split(',').map((item) => item.trim()).filter(Boolean), cover: activePost?.frontmatter.cover || '/img/cover/10.webp' }; try { await api('/api/admin/posts', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: $('#post-path').value.trim(), sha: activePost?.sha, frontmatter, content: $('#post-content').value }) }); notice('文章已保存，Cloudflare 正在自动部署。'); await loadPosts(); } catch (error) { notice(error.message, true); } });
  $('#settings-form').addEventListener('submit', async (event) => { event.preventDefault(); const site = { title: $('#site-title').value.trim(), alternate: $('#site-alternate').value.trim(), subtitle: $('#site-subtitle').value.trim(), name: $('#site-name').value.trim(), author: $('#site-name').value.trim(), description: $('#site-description').value.trim(), avatar: $('#site-avatar').value.trim(), url: $('#site-url').value.trim() }; try { await api('/api/admin/settings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ site }) }); notice('个人信息已保存，Cloudflare 正在自动部署。'); } catch (error) { notice(error.message, true); } });
  $('#logout').addEventListener('click', async () => { await fetch('/api/admin/logout', { method: 'POST' }); window.location.reload(); });
  document.querySelectorAll('.nav-item').forEach((item) => item.addEventListener('click', () => showTab(item.dataset.tab)));
  init().catch((error) => notice(error.message, true));
</script>
